# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.
TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
TURSO_AUTH_TOKEN=
# Public sign-up. false = only invited people (and the very first account) can create accounts.
ALLOW_SIGNUPS=true
# Optional legacy studio key: sees every project. Leave empty to use accounts only.
ADMIN_KEY=
# Object storage driver for design JSON. "db" stores it in Turso until you pick a provider.
BLOB_DRIVER=db
# Design agent. Set one key. Gemini wins when both are set.
# Gemini key from Google AI Studio: https://aistudio.google.com/apikey
# Free tier: Google may use prompts and uploaded drawings to improve its products, and limits are shared by every user.
# Turn on billing in AI Studio before real customers use it.
GEMINI_API_KEY=
# Fallback: OpenRouter key. https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional model name. Defaults: gemini-flash-latest (Gemini), nvidia/nemotron-3.5-super-vl (OpenRouter).
AGENT_MODEL=
# Model to try when the main one is overloaded. Default gemini-flash-lite-latest on Gemini; "none" turns it off.
AGENT_BACKUP_MODEL=
# Agent requests per person per day (each pass of a reply counts, a message is 1 to 5). Default 200.
# On Gemini's free tier, set it low (e.g. 30) so one person can't use up the shared daily allowance.
AGENT_DAILY_LIMIT=
# Outside contact, both OFF by default. EMAIL_ON=true sends email (needs RESEND_API_KEY); off, mail only goes to the
# outbox table. COMMENTS_ON=true lets customers and the Studio leave comments; off, the comments API is closed.
EMAIL_ON=
COMMENTS_ON=
# Email. Without a key, emails are kept in the outbox table and printed in the dev log.
RESEND_API_KEY=
MAIL_FROM=Walkthru <hello@yourdomain.com>
# Public site address used in email links (defaults to the request host).
APP_URL=https://yourdomain.com
